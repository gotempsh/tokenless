# Plain HTTP on 8080; the platform in front of it terminates TLS.
{
	admin off
	auto_https off
}

# Every response's headers, the 404 page's included. A header block that
# deletes one is deferred, and deferred headers don't reach the error route,
# so it imports them again.
(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	import headers
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	# Shown as text when opened in a browser; `curl | sh` doesn't care.
	header /install.sh Content-Type "text/plain; charset=utf-8"
	@markdown path *.md /llms.mdx/*
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /api/search Content-Type "application/json"

	# The documentation used to live under /docs/; it is the site now. Only
	# page names are carried over: copying the rest of the path into Location
	# would make /docs/%5Cevil.example a redirect off the site, as browsers
	# read `/\evil.example` as `//evil.example`. Anything else goes home.
	@olddocs path /docs /docs/*
	route @olddocs {
		redir /docs/introduction.html / 308
		@page path_regexp page ^/docs/([a-z0-9_-]+)\.html$
		redir @page /{re.page.1} 308
		redir * / 308
	}

	# The introduction was a page of its own; it is the home page now.
	@introduction path /introduction /introduction.html
	redir @introduction / 308

	# Every page is also Markdown, for agents: /install.md is the install
	# page's, and the home page's is /.md as well as /index.md. The build
	# writes them under /llms.mdx/.
	@homemd path /.md /index.md /introduction.md
	rewrite @homemd /llms.mdx/content.md
	@md path_regexp md ^/([a-z0-9_-]+(?:/[a-z0-9_-]+)*)\.md$
	rewrite @md /llms.mdx/{re.md.1}/content.md

	# Pages are exported as /install.html, served at /install.
	try_files {path} {path}.html
	file_server
	handle_errors 404 {
		import headers
		# The page is HTML whatever was asked for, and a missing file may
		# appear with the next deploy: replace the type and caching set above
		# for a .md or a /_next/static/ path.
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
