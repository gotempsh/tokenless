# Plain HTTP on 8080; the platform in front of it terminates TLS.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	header /fonts/* Cache-Control "public, max-age=604800"
	# Shown as text when opened in a browser; `curl | sh` doesn't care.
	header /install.sh Content-Type "text/plain; charset=utf-8"

	# The documentation used to live under /docs/; it is the site now.
	redir /docs / 308
	@olddocs path_regexp olddocs ^/docs/(.*)$
	redir @olddocs /{re.olddocs.1} 308

	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
