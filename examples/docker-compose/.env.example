# The name people and proxies use to reach this host. It needs a publicly
# trusted certificate: a DNS name pointing here with ports 80 and 443 open,
# or this machine's *.ts.net name on a tailnet.
TOKENLESS_DOMAIN=tokenless.example.com

# The image tag: a release (0.3.0), a minor line (0.3) or latest.
TOKENLESS_VERSION=0.3
